{
  "name": "sinapsi",
  "version": "0.1.2",
  "description": "A framework-agnostic, SSR-safe Web Component that renders an animated 3D network graph with a configurable palette, motion, and semantic JSON nodes.",
  "type": "module",
  "license": "MIT",
  "author": "jonatassales",
  "main": "./dist/sinapsi.js",
  "module": "./dist/sinapsi.js",
  "types": "./dist/sinapsi.d.ts",
  "unpkg": "./dist/standalone/sinapsi.js",
  "jsdelivr": "./dist/standalone/sinapsi.js",
  "bin": {
    "graph": "./cli/graph"
  },
  "files": [
    "dist",
    "cli/graph",
    "cli/readme.md",
    "cli/src"
  ],
  "packageManager": "pnpm@12.4.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonatassales/sinapsi.git"
  },
  "bugs": {
    "url": "https://github.com/jonatassales/sinapsi/issues"
  },
  "homepage": "https://github.com/jonatassales/sinapsi",
  "keywords": [
    "web-components",
    "custom-elements",
    "network-graph",
    "plexus",
    "canvas",
    "animation",
    "motion",
    "framework-agnostic",
    "ssr",
    "react",
    "vue",
    "svelte",
    "angular"
  ],
  "scripts": {
    "pnpm:devPreinstall": "./cli/graph setup --launcher --bootstrap",
    "setup": "./cli/graph setup --launcher",
    "prepack": "./cli/graph check"
  },
  "dependencies": {
    "motion": "13.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "happy-dom": "20.14.5",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "semver": "7.8.5",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "exports": {
    ".": {
      "types": "./dist/sinapsi.d.ts",
      "import": "./dist/sinapsi.js",
      "default": "./dist/sinapsi.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./react-types": {
      "types": "./dist/react-types.d.ts",
      "import": "./dist/react-types.js",
      "default": "./dist/react-types.js"
    },
    "./standalone": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/standalone/sinapsi.js",
      "default": "./dist/standalone/sinapsi.js"
    },
    "./index.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/browser.js",
    "./dist/index.css",
    "./dist/standalone/sinapsi.js"
  ],
  "engines": {
    "node": ">=24"
  }
}
